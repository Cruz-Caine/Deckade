<component type="desktop-application">
  <id>com.deckade.Deckade</id>
  <metadata_license>MIT</metadata_license>
  <name>Deckade</name>
  <summary>Controller-first Fightcade frontend for Linux and Steam Deck</summary>
  <description>
    <p>
      Deckade is a native Qt 6 client for Fightcade. It provides a big-picture,
      controller-friendly lobby and launches native FBNeo, Snes9x, and Flycast
      runtimes without Wine or an embedded browser.
    </p>
    <p>
      Deckade does not include game ROMs or BIOS files. It can download ROMs
      from the same metadata sources Fightcade uses.
    </p>
  </description>
